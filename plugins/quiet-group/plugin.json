{
  "format": "whale-plugin/1",
  "level": 4,
  "id": "quiet-group",
  "name": "群聊安静模式",
  "author": "WilliamsSum",
  "version": "1.1.1",
  "minAppVersion": "4.3.0",
  "description": "在指定微信群拦截普通消息的自动回复，保留明确 @ 机器人和引用回复机器人；4 级 Node 插件，需确认完整系统权限。群名单留空时沿用宿主规则，不联网、不发送消息。",
  "entry": "plugin.js",
  "runtime": "node-full",
  "provides": {
    "chat.pre_reply@1": {
      "mode": "gate",
      "scope": "all"
    }
  },
  "calls": [],
  "settingsSchema": {
    "type": "object",
    "properties": {
      "groups": {
        "type": "string",
        "title": "启用安静模式的群 ID",
        "description": "填写微信会话 ID，以逗号分隔；留空表示所有会话沿用宿主规则。",
        "maxLength": 2000
      }
    },
    "additionalProperties": false
  },
  "executionTimeoutMs": 10000
}
