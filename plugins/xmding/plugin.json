{
  "format": "whale-plugin/1",
  "level": 4,
  "id": "xmding",
  "name": "小咪叮（4 级）",
  "author": "atroy",
  "version": "2.0.2",
  "minAppVersion": "4.3.0",
  "description": "按会话 ID 或联系人名称发送文字或语音意图，支持 dryRun 与联系人搜索；新协议不再支持图片、回执查询和独立监听转发。",
  "entry": "plugin.js",
  "runtime": "node-full",
  "provides": {
    "tool.run@1": { "mode": "tool", "scope": "manual" }
  },
  "calls": ["contacts.list@1", "message.send@1"],
  "settingsSchema": {
    "type": "object",
    "properties": {
      "keepNewline": { "type": "boolean", "title": "保留换行", "description": "旧版默认把换行替换成 VT 以绕过旧发送器；新协议不保证该行为，默认原样发送。" }
    },
    "additionalProperties": false
  },
  "executionTimeoutMs": 45000
}
