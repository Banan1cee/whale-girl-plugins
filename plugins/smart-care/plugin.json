{
  "format": "whale-plugin/1",
  "level": 4,
  "id": "smart-care",
  "name": "智能搭话（新协议版）",
  "author": "Jy-Levent",
  "version": "2.0.1",
  "minAppVersion": "4.3.0",
  "description": "保留点名搭话、搜索增强、定时主动搭话与被无视生气；内部 config/care-state/contacts/persona/DeepSeek Key 直读全部改为 host.call 或降级，官方 care 同时开启时可能双发。",
  "entry": "plugin.js",
  "runtime": "node-full",
  "provides": {
    "task.tick@1": {
      "mode": "schedule",
      "scope": "all",
      "intervalSeconds": 60
    },
    "chat.pre_reply@1": {
      "mode": "gate",
      "scope": "all"
    },
    "chat.prompt@1": {
      "mode": "enhance",
      "scope": "all"
    },
    "chat.search@1": {
      "mode": "replace",
      "scope": "all"
    }
  },
  "calls": [
    "care.decide@1",
    "contacts.list@1",
    "persona.read@1",
    "model.complete@1",
    "message.send@1",
    "search.query@1"
  ],
  "settingsSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "启用",
        "description": "关闭后插件完全不干预。"
      },
      "minIntervalMinutes": {
        "type": "number",
        "minimum": 0,
        "maximum": 1440,
        "title": "搜索最小间隔（分钟）",
        "description": "两次搜索增强之间的最短间隔，默认 30。"
      },
      "maxPerHour": {
        "type": "integer",
        "minimum": 1,
        "maximum": 60,
        "title": "每小时搜索上限",
        "description": "限制联网预算，默认 4。"
      },
      "careInterestChance": {
        "type": "number",
        "minimum": 0,
        "maximum": 100,
        "title": "带兴趣话题的概率",
        "description": "点名/定时搭话使用兴趣话题的百分比，默认 90。"
      },
      "autoCare": {
        "type": "boolean",
        "title": "接管定时主动搭话",
        "description": "按宿主 care 配置的窗口/白名单/频率主动搭话；默认开。"
      },
      "angryEnabled": {
        "type": "boolean",
        "title": "被无视会生气",
        "description": "连续被无视后按等级生气；默认开。"
      },
      "ignoreThreshold": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10,
        "title": "连续几次没回才生气",
        "description": "默认 2。"
      },
      "ignoreWindowMinutes": {
        "type": "number",
        "minimum": 1,
        "maximum": 240,
        "title": "多久没回算被无视（分钟）",
        "description": "默认 20。"
      },
      "outboundGapMinutes": {
        "type": "number",
        "minimum": 0,
        "maximum": 240,
        "title": "搭话/生气间隔（分钟）",
        "description": "两类主动消息的最小间隔，默认 10。"
      },
      "angryStartDelayMinutes": {
        "type": "number",
        "minimum": 1,
        "maximum": 720,
        "title": "生气触发延迟（分钟）",
        "description": "达到阈值后还要沉默多久才发第一句，默认 30。"
      },
      "angryLevelUpMinutes": {
        "type": "number",
        "minimum": 5,
        "maximum": 720,
        "title": "生气升级间隔（分钟）",
        "description": "每级间隔，默认 60。"
      },
      "interestWords": {
        "type": "string",
        "maxLength": 400,
        "title": "兴趣词（逗号分隔）",
        "description": "旧版从 persona.customPrompt 自动提取；新 persona.read 不返回 customPrompt，改为显式填写。"
      }
    },
    "additionalProperties": false
  },
  "executionTimeoutMs": 45000,
  "dataAccess": [
    "model.prompt"
  ]
}
