{
  "format": "whale-plugin/1",
  "level": 4,
  "id": "care-plus",
  "name": "主动搭话增强（4 级）",
  "author": "kelin",
  "version": "1.0.2",
  "minAppVersion": "4.3.0",
  "description": "保留随机沉默锚点、人物卡/日记话头与候选打分；因新协议读不到官方 care 设置，目标与时段改为插件内配置，且无法自动关闭官方 care。",
  "entry": "plugin.js",
  "runtime": "node-full",
  "provides": {
    "tool.run@1": { "mode": "tool", "scope": "manual" },
    "task.tick@1": { "mode": "schedule", "scope": "all", "intervalSeconds": 300 }
  },
  "calls": [
    "persona.read@1",
    "memory.recent@1",
    "model.complete@1",
    "message.send@1",
    "care.decide@1"
  ],
  "settingsSchema": {
    "type": "object",
    "properties": {
      "targets": { "type": "string", "maxLength": 2000, "title": "目标", "description": "会话 ID，逗号分隔；空则使用 care.decide@1 给出的单个目标。" },
      "windows": { "type": "string", "maxLength": 200, "title": "允许时段", "description": "如 10:00-23:59，逗号分隔多段；空表示不限。" },
      "minIntervalMinutes": { "type": "integer", "minimum": 1, "maximum": 43200, "title": "最短沉默（分钟）" },
      "maxIntervalMinutes": { "type": "integer", "minimum": 1, "maximum": 43200, "title": "最长沉默（分钟）" },
      "maxPerDay": { "type": "integer", "minimum": 0, "maximum": 50, "title": "每天上限" },
      "bootSilentMinutes": { "type": "integer", "minimum": 0, "maximum": 1440, "title": "启动静默（分钟）" },
      "maxChars": { "type": "integer", "minimum": 12, "maximum": 200, "title": "单句字数" },
      "dryRun": { "type": "boolean", "title": "只生成不发送" }
    },
    "additionalProperties": false
  },
  "executionTimeoutMs": 90000
}
