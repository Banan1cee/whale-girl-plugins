{
  "format": "whale-plugin/1",
  "level": 3,
  "id": "context-notes",
  "name": "上下文读取",
  "author": "Xiaokun2233",
  "version": "2.0.0",
  "minAppVersion": "4.3.0",
  "description": "两个环节：回复前读最近 12 条并用独立 state 累计跨轮上下文，补一张便签（谁在连发、有没有问题没答、第几次找你）；发送前清掉 Markdown、压缩空白、拦住跑飞的长回复。",
  "entry": "plugin.wasm",
  "runtime": "wasm-restricted",
  "provides": {
    "chat.prompt@1": {
      "mode": "enhance",
      "scope": "all"
    },
    "chat.before_send@1": {
      "mode": "enhance",
      "scope": "all"
    }
  },
  "calls": [],
  "compat": "api3",
  "dataAccess": [
    "chat.history",
    "model.prompt"
  ]
}
