{
  "format": "whale-plugin/1",
  "level": 3,
  "id": "followup-window",
  "name": "接话窗口",
  "author": "Banan1cee",
  "version": "2.0.0",
  "minAppVersion": "4.3.0",
  "description": "她回完一句后，只对刚回的那个人开一段接话窗口：最多再顺接 3 句、180 秒内有效；别人一插话立刻收口，纯捧场、叫别人、超窗口都不接。替代「被 @ 一次就谁说话都回」。",
  "entry": "plugin.wasm",
  "runtime": "wasm-restricted",
  "provides": {
    "chat.pre_reply@1": {
      "mode": "gate",
      "scope": "all"
    },
    "chat.reply@1": {
      "mode": "enhance",
      "scope": "all"
    }
  },
  "calls": [],
  "compat": "api3",
  "dataAccess": []
}
