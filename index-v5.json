    "manifest": {
      "format": "whale-plugin/1",
      "level": 4,
      "id": "ruiping",
      "name": "锐评",
      "author": "Peelorange233",
      "version": "2.0.2",
      "minAppVersion": "4.3.0",
      "description": "先检索事实，再用金句或暴论锐评真实事件；4 级 Node 插件。新协议不再提供搜索渠道/attempts/dateFilter/thinking 元数据，chat.search 与 chat.generate 的 replace 为独占模式；生成失败无法交回宿主，详见 README。",
      "entry": "plugin.js",
      "runtime": "node-full",
      "provides": {
        "chat.search@1": {
          "mode": "replace",
          "scope": "all"
        },
        "chat.pre_reply@1": {
          "mode": "gate",
          "scope": "all"
        },
        "chat.generate@1": {
          "mode": "replace",
          "scope": "all"
        },
        "tool.run@1": {
          "mode": "tool",
          "scope": "manual"
        }
      },
      "calls": [
        "search.query@1",
        "model.complete@1"
      ],
      "settingsSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "金句",
              "暴论"
            ],
            "title": "锐评模式",
            "description": "金句偏短句结论；暴论偏强判断。"
          },
          "maxChars": {
            "type": "integer",
            "minimum": 12,
            "maximum": 120,
            "title": "正文上限",
            "description": "锐评正文最多多少个汉字。"
          },
          "facts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "title": "事实条数",
            "description": "最多保留几条经核对的事实。"
          },
          "minItems": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6,
            "title": "最少资料条数",
            "description": "检索结果少于此数时不锐评。"
          },
          "freshness": {
            "type": "string",
            "enum": [
              "",
              "today",
              "yesterday",
              "week",
              "month",
              "year"
            ],
            "title": "时效",
            "description": "搜索时效；空字符串表示不限定。"
          },
          "timeZone": {
            "type": "string",
            "maxLength": 64,
            "title": "时区",
            "description": "解析昨天/今天等日期时使用的 IANA 时区。"
          },
          "inChat": {
            "type": "boolean",
            "title": "聊天内启用",
            "description": "关闭后聊天搜索/生成/前置闸都不处理，只保留手动工具。"
          },
          "wake": {
            "type": "boolean",
            "title": "未被点名也接话",
            "description": "群聊未被 @ 时，命中锐评关键词由前置闸返回 wake。"
          },
          "showSources": {
            "type": "boolean",
            "title": "显示来源",
            "description": "在回复末尾附来源标题与链接。"
          },
          "evidenceItems": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8,
            "title": "证据条数",
            "description": "生成时最多取几条检索结果作为证据。"
          },
          "searchTimeoutMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 30000,
            "title": "检索超时",
            "description": "单次 search.query@1 的超时时间（毫秒）。"
          },
          "modelMaxTokens": {
            "type": "integer",
            "minimum": 100,
            "maximum": 4000,
            "title": "模型 token 上限",
            "description": "单次 model.complete@1 的 maxTokens。"
          },
          "keywords": {
            "type": "string",
            "maxLength": 200,
            "title": "触发关键词",
            "description": "逗号或空白分隔，默认锐评、暴论。"
          }
        },
        "additionalProperties": false
      },
      "executionTimeoutMs": 90000
    },
