            "description": "旧版从 persona.customPrompt 自动提取；新 persona.read 不返回 customPrompt，改为显式填写。"
          }
        },
        "additionalProperties": false
      },
      "executionTimeoutMs": 45000,
      "dataAccess": [
        "model.prompt"
      ]
