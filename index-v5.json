          },
          "minIntervalMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 43200,
            "title": "最短沉默（分钟）"
          },
          "maxIntervalMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 43200,
            "title": "最长沉默（分钟）"
          },
          "maxPerDay": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50,
            "title": "每天上限"
          },
          "bootSilentMinutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440,
            "title": "启动静默（分钟）"
          },
          "maxChars": {
            "type": "integer",
            "minimum": 12,
            "maximum": 200,
            "title": "单句字数"
          },
          "dryRun": {
            "type": "boolean",
            "title": "只生成不发送"
          }
