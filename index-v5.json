  {
    "manifest": {
      "format": "whale-plugin/1",
      "level": 4,
      "id": "codebuddy-cli-model",
      "name": "CodeBuddy CLI 直连",
      "author": "Grace-alan510",
      "version": "2.0.2",
      "minAppVersion": "4.3.0",
      "description": "本轮回复交给本机 CodeBuddy CLI 生成；失败或跳过时用鲸鲸原模型回复。Key 只在用户本机设置里保存，不进包；默认不发送聊天历史。支持微信内发「模型」菜单切换、发「当前模型」查询、发「恢复默认模型」还原。",
      "entry": "plugin.js",
      "runtime": "node-full",
      "executionTimeoutMs": 120000,
      "provides": {
        "chat.generate@1": {
          "mode": "replace",
          "scope": "all"
        }
      },
      "calls": [
        "model.complete@1"
      ],
      "settingsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "apiKey": {
            "type": "string",
            "maxLength": 500,
            "title": "CodeBuddy API Key",
            "description": "只保存在本机设置里，不随包分发"
          },
          "model": {
            "type": "string",
            "maxLength": 120,
            "title": "模型",
            "description": "编号/别名/完整 ID；留空则用菜单选择或默认模型"
          },
          "cliEntry": {
            "type": "string",
            "maxLength": 1000,
            "title": "CLI 入口路径",
            "description": "留空则自动探测 npm 全局安装位置"
          },
          "cwd": {
            "type": "string",
            "maxLength": 1000,
            "title": "CLI 工作目录",
            "description": "留空则用用户主目录"
          },
          "internetEnvironment": {
            "type": "string",
            "maxLength": 200,
            "title": "联网环境变量",
            "description": "透传给 CLI 的可选环境名"
          },
          "useHostSystem": {
            "type": "boolean",
            "title": "使用宿主 system",
            "description": "默认开启，把鲸鲸 system prompt 交给 CLI"
          },
          "historyTurns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12,
            "title": "携带历史轮数",
            "description": "默认 0；开启后把最近 N 轮交给 CLI"
          },
          "skipPatterns": {
            "type": "string",
            "maxLength": 2000,
            "title": "跳过词",
            "description": "换行或逗号分隔；命中时交回原模型"
          },
          "onError": {
            "type": "string",
            "enum": [
              "notify-once",
              "fallback"
            ],
            "title": "失败处理",
            "description": "notify-once 每会话提示一次，fallback 静默交回原模型"
          },
          "debug": {
            "type": "boolean",
            "title": "显示错误码",
            "description": "默认关闭，只在提示里附加错误类别"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 115000,
            "title": "CLI 超时",
            "description": "默认 110000 毫秒"
          }
        }
      },
      "dataAccess": [
        "model.prompt",
        "chat.history"
      ]
    },
    "manifestSha256": "304ff0006269fb868d615f3c871fd96fd04273630758555675f3dc0955c6e48e",
