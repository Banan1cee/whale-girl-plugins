          },
          "angryLevelUpMinutes": {
            "type": "number",
            "minimum": 5,
            "maximum": 720,
            "title": "生气升级间隔（分钟）",
            "description": "每级间隔，默认 60。"
          },
          "interestWords": {
            "type": "string",
            "maxLength": 400,
