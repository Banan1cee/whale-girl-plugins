            "description": "默认 20。"
          },
          "outboundGapMinutes": {
            "type": "number",
            "minimum": 0,
            "maximum": 240,
            "title": "搭话/生气间隔（分钟）",
            "description": "两类主动消息的最小间隔，默认 10。"
          },
          "angryStartDelayMinutes": {
            "type": "number",
            "minimum": 1,
            "maximum": 720,
            "title": "生气触发延迟（分钟）",
