          "mode": "schedule",
          "scope": "all",
          "intervalSeconds": 300
        }
      },
      "calls": [
        "persona.read@1",
        "memory.recent@1",
        "model.complete@1",
        "message.send@1",
        "care.decide@1"
      ],
      "settingsSchema": {
        "type": "object",
        "properties": {
          "targets": {
            "type": "string",
            "maxLength": 2000,
