    "manifest": {
      "format": "whale-plugin/1",
      "level": 4,
      "id": "notes",
      "name": "随手记",
      "author": "zh-hang",
      "version": "2.0.2",
      "minAppVersion": "4.3.0",
      "description": "本地随手记：/record 记录并自动归类，/read 按时间、类别、关键词或编号读回，/delete 软删除并支持 undo，/whoami 查看宿主字段。记录按发送者隔离，只写插件自己的数据目录；超长内容分段经宿主发送通道排队补发，不保证立即送达。",
      "entry": "plugin.js",
      "runtime": "node-full",
      "executionTimeoutMs": 20000,
      "provides": {
        "chat.generate@1": {
          "mode": "replace",
          "scope": "all"
        }
      },
      "calls": [
        "message.send@1",
        "model.complete@1"
      ],
      "settingsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "noteDir": {
            "type": "string",
            "maxLength": 200,
            "title": "笔记目录",
            "description": "插件数据目录下的相对目录，默认 note"
          },
          "readLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "title": "每次读取条数",
            "description": "默认 10"
          },
          "maxItemChars": {
            "type": "integer",
            "minimum": 100,
            "maximum": 20000,
            "title": "单条上限",
            "description": "单条记录最多多少字，默认 5000"
          },
          "allowDelete": {
            "type": "boolean",
            "title": "允许删除",
