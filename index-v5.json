      "minAppVersion": "4.3.0",
      "description": "保留随机沉默锚点、人物卡/日记话头与候选打分；因新协议读不到官方 care 设置，目标与时段改为插件内配置，且无法自动关闭官方 care。",
      "entry": "plugin.js",
      "runtime": "node-full",
      "provides": {
        "tool.run@1": {
          "mode": "tool",
